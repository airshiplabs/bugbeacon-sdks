{
  "name": "@bugbeacon/browser",
  "version": "0.2.1",
  "description": "Browser SDK for Bug Beacon: add an accessible Report Bug button to any web app that opens your hosted bug report form.",
  "keywords": [
    "browser",
    "bug-beacon",
    "bug-report",
    "bug-reporting",
    "bug-tracker",
    "feedback",
    "feedback-button",
    "feedback-widget",
    "issue-tracker",
    "qa",
    "report-bug",
    "widget"
  ],
  "homepage": "https://bugbeacon.ai",
  "bugs": {
    "url": "https://github.com/airshiplabs/bugbeacon-sdks/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airshiplabs/bugbeacon-sdks.git",
    "directory": "."
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "examples"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/bugbeacon.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "node --test scripts/file-token-limit.test.mjs && npm run build && node --experimental-strip-types --test tests/*.test.ts && playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && node scripts/check-vector-hash.mjs && npm test",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
