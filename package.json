{
  "name": "@bugbeacon/browser",
  "version": "0.1.0",
  "description": "Browser SDK with an accessible Report Bug button for the BugBeacon hosted form.",
  "homepage": "https://bugbeacon.ai",
  "bugs": {
    "url": "https://github.com/airshiplabs/bugbeacon-sdks/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airshiplabs/bugbeacon-sdks.git"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "examples"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/bugbeacon.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.ts && playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && node scripts/check-vector-hash.mjs && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
